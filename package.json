{
  "name": "noobz-automater",
  "version": "1.0.0",
  "description": "NoobZ - Mouse & Keyboard Automater. Types text into any application character by character.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win msi"
  },
  "author": "NoobZ",
  "license": "MIT",
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.noobz.automater",
    "productName": "NoobZ Automater",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "icon.png"
    ],
    "asarUnpack": [
      "**/node_modules/@nut-tree-fork/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        "msi"
      ],
      "icon": "build/icon.ico"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
